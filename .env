# Environment configuration for Dashie-v1

# Application settings
APP_NAME=Dashie
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000

# Database configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dashie_db
DB_USERNAME=root
DB_PASSWORD=secret

# Authentication keys
JWT_SECRET=your_jwt_secret_key
SESSION_SECRET=your_session_secret_key

# API keys
API_KEY=your_api_key_here

# Other configurations
LOG_LEVEL=debug
CACHE_DRIVER=file
QUEUE_CONNECTION=sync